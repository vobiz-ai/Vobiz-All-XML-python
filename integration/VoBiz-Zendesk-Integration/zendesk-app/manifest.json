{
  "name": "Vobiz Calling",
  "author": {
    "name": "Vobiz",
    "email": "support@vobiz.ai",
    "url": "https://vobiz.ai"
  },
  "defaultLocale": "en",
  "private": false,
  "termsConditionsURL": "https://vobiz.ai/terms",
  "location": {
    "support": {
      "top_bar": {
        "url": "assets/index.html",
        "size": { "width": "340px", "height": "560px" },
        "preloadPane": true,
        "autoHide": false
      },
      "ticket_sidebar": {
        "url": "assets/ticket-sidebar.html",
        "size": { "width": "100%", "height": "140px" }
      },
      "background": {
        "url": "assets/background.html"
      }
    }
  },
  "parameters": [
    {
      "name": "backend_url",
      "type": "text",
      "required": true,
      "secure": false
    },
    {
      "name": "agent_id",
      "type": "text",
      "required": true,
      "secure": false
    },
    {
      "name": "registrar_url",
      "type": "text",
      "required": false,
      "secure": false,
      "default": "wss://registrar.vobiz.ai:5063/"
    }
  ],
  "version": "2.0.0",
  "frameworkVersion": "2.0"
}
